" Shared base config for vim and neovim.
set nocompatible
syntax on
filetype plugin indent on

set number
" set relativenumber
set ruler
set showcmd
set hidden
set mouse=a

set tabstop=2
set shiftwidth=2
set softtabstop=2
set expandtab
set smartindent

set ignorecase
set smartcase
set incsearch
set hlsearch

set splitright
set splitbelow
set clipboard=unnamedplus
set updatetime=300
